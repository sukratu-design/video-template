{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "local": {
      "use": "@hypit/credential-store-local"
    },
    "env": {
      "use": "@hypit/credential-store-env"
    }
  },
  "endpoints": {
    "hypihub.default": {
      "use": "@hypit/provider-hypihub",
      "config": {
        "baseUrl": "https://hypit.ai",
        "apiKey": {
          "store": "local",
          "key": "hypihub.oauth"
        }
      }
    },
    "media.local": {
      "use": "@hypit/media-local"
    },
    "html.local": {
      "use": "@hypit/provider-html-local"
    },
    "image.opencv.local": {
      "use": "@hypit/provider-image-opencv-local"
    },
    "monid.default": {
      "use": "@hypit/provider-monid",
      "pool": "monid.default",
      "config": {
        "apiKey": {
          "store": "env",
          "key": "MONID_API_KEY"
        },
        "defaultConcurrency": 3,
        "pollIntervalMs": 10000
      }
    }
  },
  "bindings": {
    "@hypit/seedance@1#seedance-2": "monid.default",
    "@hypit/seedance@1#seedance-2-fast": "monid.default",
    "@hypit/seedance@1#seedance-2-mini": "monid.default",
    "@hypit/seedance@1#seedance-2.5": "monid.default",
    "@hypit/minimax-h3@1#minimax-h3": "monid.default",
    "@hypit/wan@1#wan-2.7-image": "monid.default",
    "@hypit/wan@1#wan-2.7-image-pro": "monid.default"
  }
}
